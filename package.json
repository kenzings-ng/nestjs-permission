{
  "name": "@kenzings/nestjs-permission",
  "version": "0.2.1",
  "description": "Permission-based authorization for NestJS with roles, direct permissions, wildcard permissions, guards, decorators, multi-tenancy, and database-agnostic persistence (MySQL, PostgreSQL, MongoDB, and more).",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nestjs",
    "nest",
    "permission",
    "permissions",
    "authorization",
    "authz",
    "rbac",
    "acl",
    "access-control",
    "role-based-access-control",
    "nestjs-guard",
    "nestjs-decorator",
    "wildcard-permissions",
    "multi-tenant",
    "multi-tenancy",
    "mongoose",
    "typescript"
  ],
  "homepage": "https://github.com/kenzings-ng/nestjs-permission#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenzings-ng/nestjs-permission.git"
  },
  "bugs": {
    "url": "https://github.com/kenzings-ng/nestjs-permission/issues"
  },
  "author": "kenzings-ng",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "nest-permission": "bin/nest-permission.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mongoose": {
      "types": "./dist/mongoose/index.d.ts",
      "import": "./dist/mongoose/index.js",
      "require": "./dist/mongoose/index.js",
      "default": "./dist/mongoose/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/mongoose": "^10.0.0 || ^11.0.0",
    "mongoose": "^8.0.0 || ^9.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/mongoose": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "jest": "^30.0.0",
    "mongoose": "^9.7.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
